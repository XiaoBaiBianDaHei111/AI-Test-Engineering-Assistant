# 1) Docker Compose PostgreSQL（默认主路径；宿主侧访问地址 localhost:5433，compose 映射 5433:5432）：
DATABASE_URL=postgresql+psycopg://testworkflow:testworkflow@localhost:5433/ai_test_workflow
# 2) 容器内运行 backend：由 compose 注入 `@db:5432`（Docker 内部 hostname），不读本文件；
# 3) 本机原生 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>

# --- 允许跨域的前端地址（逗号分隔） ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- 日志 ---
LOG_LEVEL=INFO
DEBUG=false

# --- 证据 / 产物目录 ---
ARTIFACTS_DIR=artifacts

# --- 执行配置
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_ACTION_TIMEOUT_MS=15000
RUN_SCRIPT_SUBDIR=scripts

# --- 证据保留 / 体积（Phase 6） ---
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_MAX_RUN_BYTES=104857600

# --- 失败分析（Phase 7） ---
FAILURE_ANALYSIS_CONFIDENCE_THRESHOLD=0.7
FAILURE_RULE_CONFIDENCE=0.93
FAILURE_CONTEXT_MAX_CHARS=8000

# --- 报告（Phase 8） ---
REPORTS_DIR=artifacts/reports

# --- API 测试（Phase 9） ---
API_REQUEST_TIMEOUT_SECONDS=10
API_RESPONSE_BODY_MAX_CHARS=8192

# --- Schema 兼容性检查（P011 hotfix） ---
# 设为 1 跳过启动期 schema 检查（逃生阀，仅临时；推荐重建数据库）
SKIP_SCHEMA_CHECK=false

# =====================================================================
# LLM 配置（真实 DeepSeek，P013 起仅真实模式；真实 key 只放 .env，不提交）
# =====================================================================
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_TEMPERATURE=0
# 长 PRD 分段阈值（字符数），超过则按标题/段落/固定块分段
LLM_MAX_INPUT_CHARS=12000
